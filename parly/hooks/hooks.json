{
  "description": "Shows new hub messages when a session starts and before each prompt, and wakes an idle session when one arrives, so nobody has to say \"check your inbox\".",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hub-events.mjs\" --client claude-code --event session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hub-events.mjs\" --client claude-code --event prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/hub-events.mjs\" --client claude-code --event listen",
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
